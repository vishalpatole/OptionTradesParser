<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
  </PropertyGroup>

  <!-- 🔥 THE CRITICAL FIX: Stops your main app from looking inside the client folder -->
  <ItemGroup>
    <Compile Remove="client\**" />
    <EmbeddedResource Remove="client\**" />
    <None Include="client\**" />
  </ItemGroup>

  <!-- Parser regression harness: its own entry point, so it must stay out of the app build. -->
  <ItemGroup>
    <Compile Remove="_harness\**" />
    <None Include="_harness\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Discord.Net" Version="3.20.1" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <None Update="AppConfig.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="client\CSharpAPI.csproj" />
  </ItemGroup>

</Project>
